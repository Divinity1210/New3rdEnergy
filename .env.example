# ===== 3RD ENERGY PLATFORM — ENVIRONMENT VARIABLES =====
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# Site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://3rdenergy.com

# WhatsApp Business Number (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=0000000000

# Email Configuration (Phase 1: console logging, future: transactional email)
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# NOTIFICATION_EMAIL=leads@3rdenergy.com

# CRM Configuration (Phase 1: local, future: hubspot/salesforce/zoho/dynamics)
# CRM_PROVIDER=local
# HUBSPOT_API_KEY=
# SALESFORCE_TOKEN=
# ZOHO_TOKEN=
# DYNAMICS_TOKEN=

# File Storage (Phase 1: local, future: s3/gcs)
# STORAGE_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GCS_BUCKET=

# Analytics (Phase 1: console, future: plausible/umami/ga4)
# ANALYTICS_PROVIDER=console
# PLAUSIBLE_DOMAIN=
# UMAMI_WEBSITE_ID=
# GA4_MEASUREMENT_ID=

# AI Service (Phase 1: rule-based, future: gemini/openai)
# AI_PROVIDER=rule-based
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Authentication (Phase 4: customer accounts)
# AUTH_PROVIDER=
# AUTH_SECRET=
# NEXTAUTH_URL=

# Phase 3: Admin Authentication
# JWT_SECRET - Auto-generated on first boot if not set
# JWT_SECRET=your-256-bit-secret-here
# Default admin credentials (created on first boot, change immediately)
# ADMIN_EMAIL=admin@3rdenergy.com
# ADMIN_PASSWORD=Change-This-Immediately!
